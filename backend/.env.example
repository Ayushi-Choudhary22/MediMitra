# Paste your MongoDB Atlas connection string
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/medimitra

# Your Vercel frontend URL (set AFTER deploying frontend)
FRONTEND_URL=https://your-medimitra.vercel.app

PORT=5000

# Gemini API key for the AI Assistant feature — get one free at
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay test keys — get them free at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
