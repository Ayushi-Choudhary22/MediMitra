# Set this in Vercel dashboard → Project Settings → Environment Variables
# Paste your Render backend URL here (no trailing slash)
VITE_API_URL=https://your-medimitra-backend.onrender.com

# Shows a "Demo Payment" button next to the real Razorpay button, for
# interviews/demonstrations where a real payment can't be made.
# Set to "false" (or remove) before a real production deployment.
VITE_ENABLE_DEMO_PAYMENT=true
